# codex-reporter settings, read with `node --env-file=<this file>` by the service scripts/install.ts writes.
# install.ts copies this template to ~/.sitrep/codex-reporter.env (mode 0600) and fills in the server URL and
# the admin secret. One KEY=VALUE per line; a line starting with # is a comment. Restart the service after a change.

# Where reports go: the server's URL as this machine reaches it (default http://127.0.0.1:4317).
CODEX_REPORTER_SERVER_URL=http://127.0.0.1:4317

# The server's admin secret, sent as X-Sitrep-Token. Empty when the server runs without one.
CODEX_REPORTER_TOKEN=

# How far Codex sessions on this machine take answers from the dashboard: off, questions, questions-and-plans or
# everything (default everything).
CODEX_REPORTER_RESPOND=everything

# Send the live activity feed of a loop someone is watching in the dashboard: on unless off, false or 0 (default on).
# Answering from the dashboard needs it on.
CODEX_REPORTER_ACTIVITY_FEED=on

# The codex executable the reporter runs to find the Codex daemon (default codex, from the service's PATH).
# CODEX_REPORTER_CODEX_BIN=codex
