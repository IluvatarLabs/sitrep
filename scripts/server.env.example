# SITREP server settings, read with `node --env-file=<this file>` by the service scripts/install.ts writes.
# install.ts copies this template to ~/.sitrep/server.env (mode 0600) and fills in the address, the port, the
# database path and a new admin secret. One KEY=VALUE per line; a line starting with # is a comment. Restart the
# service after a change. Every setting the server reads is listed here, with the default it uses when the setting is
# unset or empty; docs/OPERATIONS.md explains each one.
#
# Answering, the activity feed, the lifecycle timers, retention and the stuck thresholds are also edited in the
# dashboard's Settings, which keeps them in the database and applies them at once; the values here are their defaults.

# Where the server listens (default 127.0.0.1). 127.0.0.1 keeps it to this machine; 0.0.0.0 (or the LAN address) lets
# other machines report to it and open the dashboard.
HOST=127.0.0.1
PORT=7487

# The admin secret. Reporters send it in the X-Sitrep-Token header and you sign in with it to answer sessions.
# Empty turns auth off: the server takes reports from anyone, and nothing can be answered from the dashboard. The
# server warns at start about a secret shorter than 24 characters.
SITREP_TOKEN=

# The SQLite database file (default <repository>/data/sitrep.sqlite). The server keeps it in WAL mode, so
# -wal and -shm files sit beside it.
SITREP_DB=

# Host names other machines type to reach the server, comma-separated, such as server,server.lan. localhost, ::1,
# 127.x.x.x and the HOST address always work, and with HOST=0.0.0.0 so does any IP address.
SITREP_ALLOWED_HOSTS=

# Answering sessions from the dashboard, and the live activity feed: on or off (also true/false, 1/0), default on. Any
# other value stops the server at start. Answering also needs the activity feed on.
SITREP_RESPOND=on
SITREP_ACTIVITY_FEED=on

# Price overrides, a JSON file laid over LiteLLM's price table (default <repository>/server/prices.json).
SITREP_PRICES=

# Whether the dashboard shows anything before signing in: on or off, default off (the default for the switch in Settings).
# SITREP_REQUIRE_SIGN_IN_TO_VIEW=off

# How much the server logs: debug, info, warn or error (default info; any other value reads as info).
# SITREP_LOG_LEVEL=info

# The commit of a development build (7 to 40 hex digits, optionally followed by -dirty), sent with the server's version;
# any other value is ignored. Leave it unset for an installed server.
# SITREP_BUILD=

# Lifecycle timers and retention in milliseconds, shown with their defaults. A value that is not a number of 0 or more
# reads as the default.
# REMOVE_AFTER_MS=75000
# LINGER_MS=8000
# DETACHED_HIDE_AFTER_MS=60000
# RETAIN_SAMPLES_MS=86400000
# RETAIN_EVENTS_MS=2592000000
# RETAIN_SESSIONS_MS=2592000000

# How long a running loop may show no activity before it is stuck, in milliseconds by model family, shown with their
# defaults (doubled while a tool call is open). Same rule for a value that is not a number of 0 or more.
# STUCK_AFTER_MS_OPUS=600000
# STUCK_AFTER_MS_SONNET=240000
# STUCK_AFTER_MS_HAIKU=180000
# STUCK_AFTER_MS_FABLE=180000
# STUCK_AFTER_MS_OPENAI=180000
# STUCK_AFTER_MS_OTHER=180000

# Node's own time zone setting: "today" in the cost figures starts at local midnight in this zone. Empty: this
# machine's zone.
# TZ=
